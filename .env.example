ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5079

POSTGRES_DB=ic_uvv
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=ic_uvv;Username=admin;Password=change-this-postgres-password

Rdf__FusekiBaseUrl=http://localhost:3030
Rdf__FusekiDataset=icc_uvv
Rdf__FusekiUsername=admin
Rdf__FusekiPassword=change-this-fuseki-password
FUSEKI_BASE_URL=http://localhost:3030
FUSEKI_DATASET=icc_uvv
FUSEKI_USERNAME=admin
FUSEKI_PASSWORD=change-this-fuseki-password
FUSEKI_HOST=fuseki
FUSEKI_PORT=3030

Rdf__QleverBaseUrl=http://localhost:7011
Rdf__QleverIndex=icc_uvv
Security__AllowLoopbackUrls=true
Security__AllowedHosts__0=localhost
Security__AllowedHosts__1=127.0.0.1
Security__AllowedHosts__2=::1
Security__AllowedHosts__3=fuseki
Security__AllowedHosts__4=qlever

Auth__JwtIssuer=icc-uvv
Auth__JwtAudience=icc-uvv-api
Auth__JwtKey=replace-with-a-key-of-at-least-32-characters
Auth__DefaultUsername=rdf-admin
Auth__DefaultPassword=change-this-admin-password
Auth__TokenExpirationMinutes=60

Frontend__Url=http://localhost:4040
FRONTEND_PORT=4040
FRONTEND_URL=http://localhost:4040
FRONTEND_API_URL=http://localhost:5079/api/v1
BACKEND_URL=http://localhost:5079
RUN_BACKEND_INTEGRATION=false
